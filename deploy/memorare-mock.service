# Local stand-in for the Memorare IdP, loopback only. Remove once real
# credentials are configured and AUTH_BASE points at auth.memorare.ai.
[Unit]
Description=Memorare mock IdP (loopback only)
After=network.target

[Service]
# Behind nginx the mock lives under /mock-idp/, so scope its SSO cookie there.
Environment=MOCK_COOKIE_PATH=/mock-idp
Type=simple
WorkingDirectory=/opt/memorare-app
# Share the app's credentials so the two can never disagree.
EnvironmentFile=-/opt/memorare-app/.env.local
ExecStart=/usr/bin/node mock/idp.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# systemd unit so the app survives reboots and SSH disconnects.
# Install to /etc/systemd/system/memorare-app.service
#   systemctl daemon-reload && systemctl enable --now memorare-app

[Unit]
Description=Memorare candidate Next.js app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/memorare-app
EnvironmentFile=/opt/memorare-app/.env.local
ExecStart=/opt/memorare-app/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
